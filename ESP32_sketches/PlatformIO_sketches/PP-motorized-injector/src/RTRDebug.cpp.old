    }
    
    sendControllerModes(3, 1);
    delay(TRIPLE_SEND_SPACING_MS);
    sendControllerModes(3, 1, true);
    delay(TRIPLE_SEND_SPACING_MS);
    sendControllerModes(3, 1, true);
    
