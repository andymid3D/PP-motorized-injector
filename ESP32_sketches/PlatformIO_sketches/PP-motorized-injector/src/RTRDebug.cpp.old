}

void RTRDebug::testSetPosShortTriple() {
    Serial.printf("Starting TRIPLE set_pos_short test (3x sends, %dms apart)...\n", TRIPLE_SEND_SPACING_MS);
    clearBuffer();
    startCapture();
    
    // Pre-roll: manually poll for 100ms before TX
